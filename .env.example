# Runtime
BULLSEYE_ENVIRONMENT=development
BULLSEYE_EXECUTION_MODE=paper
BULLSEYE_LOG_LEVEL=INFO
BULLSEYE_LOG_FORMAT=console

# PostgreSQL. Keep the async driver name.
BULLSEYE_DATABASE_URL=postgresql+asyncpg://bullseye:bullseye@localhost:5432/bullseye
BULLSEYE_DATABASE_ECHO=false

# Solana public endpoints are acceptable for bootstrap only. Use a dedicated
# provider before Phase 1 forward-paper operation.
BULLSEYE_SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
BULLSEYE_SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Low-volume emergency reads for open-position exits only.
BULLSEYE_SOLANA_EXIT_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
BULLSEYE_SOLANA_COMMITMENT=confirmed
BULLSEYE_SOLANA_RPC_TIMEOUT_SECONDS=15
BULLSEYE_SOLANA_WS_OPEN_TIMEOUT_SECONDS=15
BULLSEYE_SOLANA_WS_PING_INTERVAL_SECONDS=20
BULLSEYE_SOLANA_WS_PING_TIMEOUT_SECONDS=60
BULLSEYE_SOLANA_WS_IDLE_TIMEOUT_SECONDS=20
# Optional continuous filtered full-packet budget. 0 retains the session cap.
# Enable 128000000 only after accepting the provider's recurring usage charges.
# The persistent rolling ledger survives worker restarts; do not delete it.
BULLSEYE_SOLANA_EXECUTED_STREAM_HOURLY_BYTES=0
BULLSEYE_SOLANA_RECONNECT_BASE_SECONDS=1
BULLSEYE_SOLANA_RECONNECT_MAX_SECONDS=5
BULLSEYE_SOLANA_RECONNECT_JITTER_SECONDS=0.5
BULLSEYE_SOLANA_INVALID_STATUS_HALT_THRESHOLD=3
BULLSEYE_SOLANA_HALTED_PROBE_SECONDS=900
BULLSEYE_SOLANA_ACCOUNT_RETRY_COUNT=4
BULLSEYE_SOLANA_ACCOUNT_RETRY_DELAY_SECONDS=0.4
BULLSEYE_PUMP_FINAL_STRETCH_PERCENT=80

# Phase 2 rolling feature windows and deterministic snapshot cadence.
BULLSEYE_FEATURE_WINDOWS_SECONDS=[1,5,10,15,30,60,120,300,600]
BULLSEYE_FEATURE_SNAPSHOT_INTERVAL_SECONDS=1
BULLSEYE_FEATURE_MAX_LATENESS_SECONDS=5

# Phase 3 initial research policy. These are configurable hypotheses, not alpha.
BULLSEYE_RISK_TOP1_HARD_REJECT_PERCENT=35
BULLSEYE_RISK_TOP5_WARNING_PERCENT=90
BULLSEYE_RISK_TOP10_WARNING_PERCENT=98
BULLSEYE_RISK_CREATOR_HARD_REJECT_PERCENT=20
BULLSEYE_RISK_LARGEST_BUYER_WARNING_PERCENT=50
BULLSEYE_RISK_SYNCHRONIZED_BUYERS_WARNING_COUNT=3
BULLSEYE_RISK_REASSESSMENT_INTERVAL_SECONDS=10
BULLSEYE_RISK_ASSESSMENT_WORKERS=2
BULLSEYE_RISK_ASSESSMENT_QUEUE_SIZE=500
# Local quotas persist only for one process lifetime; request metrics verify actual usage.
BULLSEYE_RISK_ASSESSMENT_MAX_PER_HOUR=180
BULLSEYE_RISK_ASSESSMENT_MAX_PER_DAY=2000
BULLSEYE_RISK_PREFILTER_WINDOW_SECONDS=30
BULLSEYE_RISK_PREFILTER_MIN_TRADES=2
BULLSEYE_RISK_PREFILTER_MIN_UNIQUE_BUYERS=1
BULLSEYE_RISK_PREFILTER_MIN_FLOW_IMBALANCE=-0.80

# Provider selection is JSON because it is a typed set.
BULLSEYE_ENABLED_PROVIDERS=["solana_rpc"]

# PumpPortal is the budgeted primary Pump.fun/PumpSwap discovery stream when an
# API key is configured. Trade messages are paid; keep the hard daily cap.
BULLSEYE_PUMPPORTAL_API_KEY=
BULLSEYE_PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
BULLSEYE_PUMPPORTAL_CANDIDATE_OBSERVATION_SECONDS=60
BULLSEYE_PUMPPORTAL_MAX_ACTIVE_TOKEN_SUBSCRIPTIONS=4
# 0 = continuous metered stream; PumpPortal charges the linked wallet per message.
BULLSEYE_PUMPPORTAL_MAX_TRADE_EVENTS_PER_DAY=5000
BULLSEYE_PUMPPORTAL_TRADE_BUDGET_RESERVE_PERCENT=10
BULLSEYE_PUMPPORTAL_CANDIDATE_SUBSCRIPTION_INTERVAL_SECONDS=2
BULLSEYE_PUMPPORTAL_MAX_TRADE_EVENTS_PER_CANDIDATE=24

# Birdeye (required for the planned Birdeye adapter; not needed in Phase 0)
BULLSEYE_BIRDEYE_API_KEY=
BULLSEYE_BIRDEYE_BASE_URL=https://public-api.birdeye.so
BULLSEYE_BIRDEYE_TIMEOUT_SECONDS=10
BULLSEYE_BIRDEYE_CACHE_SECONDS=300
BULLSEYE_BIRDEYE_MINIMUM_INTERVAL_SECONDS=1.1
BULLSEYE_BIRDEYE_MONTHLY_CU_BUDGET=25000

# Phase 10A candidate-only Alpha Filter. Market/deployer observations remain
# shadow research; extreme labeled-holder concentration can reject paper entries.
BULLSEYE_ALPHA_FILTER_ENABLED=true
BULLSEYE_ALPHA_FILTER_SHADOW_MODE=false
BULLSEYE_ALPHA_BIRDEYE_HOLDER_PROFILES_PER_DAY=10
BULLSEYE_ALPHA_BIRDEYE_CACHE_SECONDS=21600
BULLSEYE_ALPHA_MAX_DEV_SUPPLY_PERCENT=20
BULLSEYE_ALPHA_MAX_INSIDER_SUPPLY_PERCENT=20
BULLSEYE_ALPHA_MAX_BUNDLER_SUPPLY_PERCENT=40
BULLSEYE_ALPHA_MAX_SNIPER_SUPPLY_PERCENT=50

# Paper portfolio defaults
BULLSEYE_STARTING_CAPITAL=1000
BULLSEYE_STARTING_CAPITAL_CURRENCY=USDT
BULLSEYE_PAPER_TRADING_ENABLED=true
BULLSEYE_PAPER_BASE_POSITION_PERCENT=30
BULLSEYE_PAPER_MAX_POSITION_PERCENT=40
BULLSEYE_PAPER_MAX_OPEN_POSITIONS=8
BULLSEYE_PAPER_MAX_TOTAL_EXPOSURE_PERCENT=40
BULLSEYE_PAPER_DAILY_LOSS_LIMIT_PERCENT=10
BULLSEYE_PAPER_STOP_LOSS_RISK_RESERVE_PERCENT=30
BULLSEYE_PAPER_CONSECUTIVE_LOSS_LIMIT=6
BULLSEYE_PAPER_LOSS_COOLDOWN_SECONDS=600
BULLSEYE_PAPER_MINT_REENTRY_COOLDOWN_SECONDS=900
BULLSEYE_PAPER_VENUE_FEE_BPS=125
BULLSEYE_PAPER_EXECUTION_PROVIDER_FEE_BPS=50
BULLSEYE_PAPER_LATENCY_SLIPPAGE_BPS=50
BULLSEYE_PAPER_NETWORK_FEE_SOL=0.00001
BULLSEYE_PAPER_PRIORITY_FEE_SOL=0.0001
BULLSEYE_PAPER_COMPUTE_LATENCY_MS=50
BULLSEYE_PAPER_SUBMISSION_LATENCY_MS=750
BULLSEYE_PAPER_MAX_MARKET_STALENESS_SECONDS=5
# Operational safety controls; these are not fitted strategy thresholds.
BULLSEYE_PAPER_ENTRY_MAX_FEED_AGE_SECONDS=5
BULLSEYE_PAPER_ENTRY_REQUIRE_RPC=true
BULLSEYE_PAPER_ENTRY_ALLOW_ESTIMATED_FEED_TIME=false
# Explicitly configure after validating simultaneous sources; no fitted default.
# BULLSEYE_PAPER_ENTRY_MAX_SOURCE_DISAGREEMENT_PERCENT=
BULLSEYE_PAPER_EXIT_RECOVERY_ATTEMPT_TIMEOUT_SECONDS=30
BULLSEYE_PAPER_MAX_QUOTE_PRICE_STALENESS_SECONDS=180
BULLSEYE_PAPER_PENDING_ENTRY_TTL_SECONDS=30
BULLSEYE_PAPER_PENDING_CLOSE_TTL_SECONDS=30
BULLSEYE_PAPER_POSITION_MONITOR_INTERVAL_SECONDS=5
BULLSEYE_PAPER_STOP_LOSS_PERCENT=12
BULLSEYE_PAPER_TAKE_PROFIT_PERCENT=100
BULLSEYE_PAPER_TAKE_PROFIT_FRACTION=0.5
BULLSEYE_PAPER_TRAILING_ACTIVATION_PERCENT=12
BULLSEYE_PAPER_TRAILING_STOP_PERCENT=8
BULLSEYE_PAPER_MAX_HOLDING_SECONDS=1800
BULLSEYE_PAPER_STAGNATION_EXIT_SECONDS=120
BULLSEYE_PAPER_STAGNATION_MIN_MFE_PERCENT=5
BULLSEYE_PAPER_MAX_ENTRY_PRICE_IMPACT_BPS_CONSERVATIVE=300
BULLSEYE_PAPER_MAX_ENTRY_PRICE_IMPACT_BPS_BALANCED=500
BULLSEYE_PAPER_MAX_ENTRY_PRICE_IMPACT_BPS_AGGRESSIVE=800
BULLSEYE_PAPER_MAX_ROUND_TRIP_COST_BPS_CONSERVATIVE=700
BULLSEYE_PAPER_MAX_ROUND_TRIP_COST_BPS_BALANCED=700
BULLSEYE_PAPER_MAX_ROUND_TRIP_COST_BPS_AGGRESSIVE=900
BULLSEYE_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BULLSEYE_SOCIAL_TRADING_WEIGHT_ENABLED=false

# Telegram (Phase 6). IDs are a JSON array. Never expose the token in logs.
BULLSEYE_TELEGRAM_BOT_TOKEN=
BULLSEYE_TELEGRAM_ALLOWED_USER_IDS=[]
BULLSEYE_TELEGRAM_TRADE_NOTIFICATIONS_ENABLED=true
BULLSEYE_TELEGRAM_TRACKED_WALLET_NOTIFICATIONS_ENABLED=true
BULLSEYE_TELEGRAM_NOTIFICATION_MINIMUM_INTERVAL_SECONDS=1.0
BULLSEYE_TELEGRAM_NOTIFICATION_DUPLICATE_COOLDOWN_SECONDS=60
BULLSEYE_WALLET_EARLY_ENTRY_SECONDS=30
BULLSEYE_WALLET_CANDIDATE_MIN_LAUNCHES=3
BULLSEYE_WALLET_SCORED_MIN_LAUNCHES=10
BULLSEYE_WALLET_HIGH_CONFIDENCE_MIN_LAUNCHES=30
BULLSEYE_TELEGRAM_POLLING_TIMEOUT_SECONDS=20
BULLSEYE_TELEGRAM_MAX_CONCURRENT_UPDATES=8

# X API (Phase 10, optional and pay-per-use)
BULLSEYE_X_BEARER_TOKEN=

# Local Ollama (Phase 11, optional and outside the execution path)
BULLSEYE_OLLAMA_BASE_URL=http://localhost:11434
BULLSEYE_OLLAMA_MODEL=

BULLSEYE_RESEARCH_OBSERVATION_SECONDS=3660
BULLSEYE_RESEARCH_MAX_ACTIVE_SUBSCRIPTIONS=8
BULLSEYE_PAPER_RUNNER_TRAILING_MIN_PERCENT=18
BULLSEYE_PAPER_RUNNER_TRAILING_MAX_PERCENT=30
BULLSEYE_PAPER_HAZARD_CONFIRMATION_SECONDS=1
BULLSEYE_RESEARCH_CONTROL_SAMPLE_PERCENT=10
BULLSEYE_PAPER_RUNNER_MAX_HOLDING_SECONDS=7200
BULLSEYE_PAPER_MAX_SIGNAL_PRICE_DRIFT_PERCENT=8
BULLSEYE_EXECUTION_MODE=paper
BULLSEYE_PAPER_MAX_SIGNAL_AGE_SECONDS=12
BULLSEYE_PAPER_MIN_POSITION_PERCENT=0.5
BULLSEYE_PAPER_RUNNER_TRAILING_ACTIVATION_PERCENT=50
BULLSEYE_PAPER_RUNNER_ENABLED=true
BULLSEYE_PAPER_RISK_PER_TRADE_PERCENT=12


BULLSEYE_PAPER_OPEN_RISK_BUDGET_PERCENT=15
BULLSEYE_PAPER_ADAPTIVE_POSITION_SIZING=true
BULLSEYE_PAPER_MIN_ORDER_AMOUNT=10
